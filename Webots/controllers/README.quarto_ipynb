        "#| echo: false\n",
        "#| output: true\n",
        "\n",
        "import json\n",
        "from pathlib import Path\n",
        "\n",
        "# --- Percorsi ---\n",
        "BASE_DIR = Path.cwd()\n",
        "\n",
        "LOG_PATH_JSON = BASE_DIR / \"Log\" / \"line_follower_Deterministic.json\"\n",
        "\n",
        "# --- Lettura JSON ---\n",
        "with open(LOG_PATH_JSON, 'r') as json_file:\n",
        "    LOG_DATA = json.load(json_file)\n",
        "\n",
        "# --- Stampa dei dati ---\n",
        "for key, value in LOG_DATA.items():\n",
        "    print(f\"{key}: {value}\")"
